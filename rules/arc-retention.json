{
  "id": "ARC-RETENTION",
  "title": "档案保管期限低于法定要求或未区分永久/定期",
  "severity": "high",
  "source": "《中华人民共和国档案法》（2020 修订）第十三条、第二十七条；《机关文件材料归档范围和文书档案保管期限规定》（国家档案局令第8号）：文书档案分永久与定期（30 年、10 年）",
  "advice": "档案保管期限应明确区分「永久」与「定期（30 年/10 年）」，且不得低于归档范围规定。此处配置的年限偏低或未区分，请按档案类别重定并保留审批记录。",
  "check": {
    "type": "file-pattern",
    "pattern": "^(?![^\\n]*(?:永久|30\\s*年|10\\s*年))[^\\n]*(?:档案|归档|保管期限)[^\\n]*(?:保存|保管|retention|keep)[^\\n]{0,12}?(?:[1-9]|[12]\\d)\\s*(?:年|y)",
    "flags": "gmi",
    "wholeFile": true,
    "exts": [
      ".yml",
      ".yaml",
      ".json",
      ".properties",
      ".toml",
      ".sql",
      ".md",
      ".txt",
      ".java",
      ".js",
      ".ts",
      ".py",
      ".xml",
      ".conf",
      ".ini"
    ],
    "max": 20,
    "when": "(?:档案|归档|保管期限|档案室)"
  }
}
