{
  "id": "ARC-DESTROY-APPROVAL",
  "title": "档案销毁无审批/无清册记录",
  "severity": "medium",
  "source": "《档案法》第二十七条：禁止擅自销毁档案；销毁须经鉴定、审批并留存清册",
  "advice": "销毁档案须经鉴定小组鉴定、单位负责人审批，并形成销毁清册（含目录、数量、审批人、监销人）。系统里应有销毁审批流程与不可篡改记录。",
  "check": {
    "type": "file-pattern",
    "pattern": "^(?![^\\n]*(?:审批|鉴定|清册|监销))[^\\n]*(?:销毁|清册|鉴定)[^\\n]*$",
    "flags": "gmi",
    "wholeFile": true,
    "exts": [
      ".yml",
      ".yaml",
      ".json",
      ".properties",
      ".toml",
      ".sql",
      ".md",
      ".txt",
      ".java",
      ".js",
      ".ts",
      ".py",
      ".xml",
      ".conf",
      ".ini"
    ],
    "max": 20,
    "when": "(?:销毁|清册|鉴定)"
  }
}
